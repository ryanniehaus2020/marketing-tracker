# Copy to .env and fill in credentials one source at a time -- see the
# Milestone plan in README.md. Leave a source's block blank until you're
# ready to wire it up; that source will be skipped (not crash the run).

# --- Asana (Milestone 1) --------------------------------------------------
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=
# Portfolio gids referenced by config/roster.py's DEDUP_PRIORITY, once
# portfolio-membership dedup is wired up (see rules.resolve_project_tag):
ASANA_PORTFOLIO_FY27_CAMPAIGNS_GID=
ASANA_PORTFOLIO_CONTENT_MARKETING_GID=

# --- Jira (Milestone 2) ---------------------------------------------------
JIRA_BASE_URL=https://degreed.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PMM_BOARD_PROJECT_KEY=PMM

# --- Confluence (Milestone 3) ---------------------------------------------
CONFLUENCE_BASE_URL=https://degreed.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_OPS_ROADMAP_PAGE_ID=

# --- HubSpot (Milestone 4) -------------------------------------------------
HUBSPOT_PRIVATE_APP_TOKEN=

# --- AI Roadmap Google Sheet (Milestone 5) --------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
AI_ROADMAP_SHEET_ID=
AI_ROADMAP_SHEET_RANGE=Sheet1!A1:F200

# --- Output paths (optional -- defaults shown) ----------------------------
SNAPSHOT_DIR=./data/snapshots
OUTPUT_HTML_PATH=./output/tracker.html
