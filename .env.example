# Copy to .env and fill in the blanks. Secrets (API tokens/keys) are never
# checked into this repo -- get those from the relevant tool's admin
# settings, per the setup notes in each sources/*.py module.

# --- Asana ---------------------------------------------------------------
ASANA_ACCESS_TOKEN=
# Degreed workspace gid, resolved 2026-08-27 via the Asana API.
ASANA_WORKSPACE_GID=1199943304774115

# Shared Atlassian cloud id (Jira + Confluence both live on this site),
# resolved 2026-08-27. Used by the header's live-refresh button, not by
# the Python jira_source.py/confluence_source.py modules (they use the
# REST base URLs below instead).
ATLASSIAN_CLOUD_ID=151636d7-9099-4803-a108-4f053f36c9fe

# --- Jira (PMM board) ------------------------------------------------------
# Site resolved 2026-08-27 -- it's degreedjira.atlassian.net, not
# degreed.atlassian.net as the module docstring guessed. Confirmed against
# https://degreedjira.atlassian.net/jira/core/projects/PMM/list (a Jira
# Core business project). Note there's also a Confluence space keyed "PM"
# (also "Product Marketing") -- don't confuse it with this Jira project.
JIRA_BASE_URL=https://degreedjira.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PMM_BOARD_PROJECT_KEY=PMM

# --- Confluence (Ops roadmap) ----------------------------------------------
# Same Atlassian site as Jira. Marketing space key is MAR (id 760938525);
# the Ops Roadmap page lives under its "Marketing Operations" parent page,
# resolved 2026-08-27.
CONFLUENCE_BASE_URL=https://degreedjira.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_OPS_ROADMAP_PAGE_ID=8566735021

# --- HubSpot ---------------------------------------------------------------
# Portal 397771 (rniehaus@degreed.com), confirmed 2026-08-27. Site-pages
# (CMS) are readable now; MARKETING_EMAIL currently returns
# REQUIRES_REAUTHORIZATION on this connection -- reauthorize the HubSpot
# connector with marketing-email read scope before this source can pull
# published emails.
HUBSPOT_PRIVATE_APP_TOKEN=

# --- Google Sheets (AI Roadmap FY27) ---------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# "Marketing-AI-Roadmap-FY27" in Drive, resolved 2026-08-27 by title
# search -- confirm this is the right sheet (a similarly-named
# "Marketing_AI_Operational_Roadmap" also exists, file id
# 11dUQx7WCBgKiZdFo8zUFKkon9aoxrfZpZbtFYWbNwl8, in the same folder).
AI_ROADMAP_SHEET_ID=1d2iH1D2jXcW-jfkhLLBAJHoKeNvHceOZie3cLKhmF0E
AI_ROADMAP_SHEET_RANGE=Sheet1!A1:F200

# --- Website Roadmap (Google Doc, not Asana) --------------------------------
# "Website Fixes & Improvements - Roadmap", Summary tab, confirmed
# 2026-08-27. This is a Google Doc, not a Sheet -- website_roadmap_source.py
# parses its month headings directly rather than reading a column-mapped
# table like sheets_source.py does. Same service-account credentials as
# the AI Roadmap sheet, just a different readonly scope (drive.readonly).
WEBSITE_ROADMAP_DOC_ID=16MTqGAve79Ij4CIBuEHjKZVu2kuHUfk1rfT-YMPvlCU
